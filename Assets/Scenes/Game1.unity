  playableDirector: {fileID: 14868665}
  cameraTransform: {fileID: 779482084}
  cameraWaypoints: []
  subtitles:
  - text: "\u0110\xEAm nay, ranh gi\u1EDBi gi\u1EEFa nh\xE2n gi\u1EDBi v\xE0 Ma C\u1EA3nh
      \u0111\xE3 r\u1EA1n n\u1EE9t..."
    triggerTime: 2
    displayDuration: 4
  - text: "Nh\u1EEFng linh h\u1ED3n canh gi\u1EEF c\u1ED5 \u1EA5n l\u1EA7n l\u01B0\u1EE3t
      l\u1EE5i t\xE0n."
    triggerTime: 6
    displayDuration: 4
  - text: "M\u1ED9t nh\u1ECBp tim th\u1EE9c t\u1EC9nh gi\u1EEFa tro t\xE0n v\xE0
      b\xF3ng t\u1ED1i."
    triggerTime: 11
    displayDuration: 4
  - text: "N\u1EBFu th\u1EA5t b\u1EA1i, b\xECnh minh s\u1EBD kh\xF4ng c\xF2n quay
      l\u1EA1i n\u1EEFa."
    triggerTime: 16
    displayDuration: 4
  - text: "H\xE3y b\u01B0\u1EDBc v\xE0o Ma C\u1EA3nh, tr\u01B0\u1EDBc khi c\xE1nh
      c\u1ED5ng \u0111\xF3ng v\u0129nh vi\u1EC5n."
    triggerTime: 21
    displayDuration: 4
  - text: "H\xE0nh tr\xECnh b\u1EAFt \u0111\u1EA7u."
    triggerTime: 27
    displayDuration: 3
